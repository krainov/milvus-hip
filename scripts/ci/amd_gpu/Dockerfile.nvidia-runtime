ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG SOURCE_COMMIT
LABEL org.opencontainers.image.revision="${SOURCE_COMMIT}"
LABEL com.dxc.milvus.gpu-ci-image="true"

COPY --chown=root:root ./bin/ /milvus/bin/
COPY --chown=root:root ./configs/ /milvus/configs/
COPY --chown=root:root ./lib/ /milvus/lib/
RUN chmod -R 774 /milvus/bin /milvus/configs /milvus/lib

ENV PATH=/milvus/bin:${PATH}
ENV LD_LIBRARY_PATH=/milvus/lib:${LD_LIBRARY_PATH}:/usr/lib
ENV LD_PRELOAD=/milvus/lib/libjemalloc.so
ENV MALLOC_CONF=background_thread:true

WORKDIR /milvus
